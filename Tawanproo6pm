-- ============ เครื่องคิดเลข ============
local function CreateCalculator()
    local calcFrame = Instance.new("Frame")
    calcFrame.Size = UDim2.new(0.9, 0, 0, 220)
    calcFrame.Position = UDim2.new(0.05, 0, 0, 310)
    calcFrame.BackgroundColor3 = Color3.fromRGB(30, 30, 40)
    calcFrame.Parent = scrollFrame
    
    local calcCorner = Instance.new("UICorner")
    calcCorner.CornerRadius = UDim.new(0, 6)
    calcCorner.Parent = calcFrame
    
    -- ชื่อเครื่องคิดเลข
    local calcTitle = Instance.new("TextLabel")
    calcTitle.Size = UDim2.new(1, 0, 0, 25)
    calcTitle.Position = UDim2.new(0, 0, 0, 0)
    calcTitle.BackgroundTransparency = 1
    calcTitle.Text = "🧮 เครื่องคิดเลข"
    calcTitle.TextColor3 = Color3.fromRGB(255, 255, 255)
    calcTitle.TextSize = 14
    calcTitle.Font = Enum.Font.GothamBold
    calcTitle.Parent = calcFrame
    
    -- ช่องแสดงผล
    local display = Instance.new("TextBox")
    display.Size = UDim2.new(0.95, 0, 0, 35)
    display.Position = UDim2.new(0.025, 0, 0, 28)
    display.BackgroundColor3 = Color3.fromRGB(20, 20, 30)
    display.TextColor3 = Color3.fromRGB(255, 255, 255)
    display.Text = "0"
    display.TextSize = 20
    display.TextXAlignment = Enum.TextXAlignment.Right
    display.ClearTextOnFocus = false
    display.Parent = calcFrame
    
    local displayCorner = Instance.new("UICorner")
    displayCorner.CornerRadius = UDim.new(0, 4)
    displayCorner.Parent = display
    
    -- ฟังก์ชันสร้างปุ่มเครื่องคิดเลข
    local function CreateCalcButton(text, xPos, yPos, color)
        local btn = Instance.new("TextButton")
        btn.Size = UDim2.new(0.22, 0, 0, 30)
        btn.Position = UDim2.new(xPos, 0, yPos, 0)
        btn.BackgroundColor3 = color or Color3.fromRGB(60, 60, 70)
        btn.TextColor3 = Color3.fromRGB(255, 255, 255)
        btn.Text = text
        btn.TextSize = 16
        btn.Font = Enum.Font.GothamBold
        btn.Parent = calcFrame
        
        local btnCorner = Instance.new("UICorner")
        btnCorner.CornerRadius = UDim.new(0, 4)
        btnCorner.Parent = btn
        
        return btn
    end
    
    -- ตัวแปรสถานะเครื่องคิดเลข
    local calcState = {
        currentNumber = "0",
        previousNumber = "",
        operation = "",
        isNewNumber = true,
        memory = 0,
        hasMemory = false
    }
    
    -- ฟังก์ชันอัพเดตหน้าจอ
    local function UpdateDisplay()
        local displayText = calcState.currentNumber
        if displayText == "" then displayText = "0" end
        display.Text = displayText
    end
    
    -- ฟังก์ชันจัดการตัวเลข
    local function InputNumber(num)
        if calcState.isNewNumber then
            calcState.currentNumber = tostring(num)
            calcState.isNewNumber = false
        else
            if calcState.currentNumber == "0" and num ~= "." then
                calcState.currentNumber = tostring(num)
            else
                calcState.currentNumber = calcState.currentNumber .. tostring(num)
            end
        end
        UpdateDisplay()
    end
    
    -- ฟังก์ชันจัดการเครื่องหมาย
    local function InputOperation(op)
        local num = tonumber(calcState.currentNumber) or 0
        if calcState.previousNumber ~= "" and calcState.operation ~= "" then
            Calculate()
        end
        calcState.previousNumber = tostring(num)
        calcState.operation = op
        calcState.isNewNumber = true
    end
    
    -- ฟังก์ชันคำนวณ
    local function Calculate()
        local current = tonumber(calcState.currentNumber) or 0
        local previous = tonumber(calcState.previousNumber) or 0
        local result = 0
        
        if calcState.operation == "+" then
            result = previous + current
        elseif calcState.operation == "-" then
            result = previous - current
        elseif calcState.operation == "×" then
            result = previous * current
        elseif calcState.operation == "÷" then
            if current ~= 0 then
                result = previous / current
            else
                display.Text = "Error"
                return
            end
        elseif calcState.operation == "^" then
            result = previous ^ current
        elseif calcState.operation == "%" then
            result = previous % current
        elseif calcState.operation == "√" then
            result = math.sqrt(current)
        end
        
        calcState.currentNumber = tostring(result)
        calcState.previousNumber = ""
        calcState.operation = ""
        calcState.isNewNumber = true
        UpdateDisplay()
    end
    
    -- ฟังก์ชันล้างค่า
    local function ClearAll()
        calcState.currentNumber = "0"
        calcState.previousNumber = ""
        calcState.operation = ""
        calcState.isNewNumber = true
        UpdateDisplay()
    end
    
    -- ฟังก์ชันลบตัวสุดท้าย
    local function Backspace()
        if #calcState.currentNumber > 1 then
            calcState.currentNumber = string.sub(calcState.currentNumber, 1, #calcState.currentNumber - 1)
        else
            calcState.currentNumber = "0"
            calcState.isNewNumber = true
        end
        UpdateDisplay()
    end
    
    -- ฟังก์ชันเปลี่ยนเครื่องหมาย
    local function ToggleSign()
        if calcState.currentNumber ~= "0" then
            if string.sub(calcState.currentNumber, 1, 1) == "-" then
                calcState.currentNumber = string.sub(calcState.currentNumber, 2)
            else
                calcState.currentNumber = "-" .. calcState.currentNumber
            end
        end
        UpdateDisplay()
    end
    
    -- ฟังก์ชัน Memory
    local function MemoryStore()
        calcState.memory = tonumber(calcState.currentNumber) or 0
        calcState.hasMemory = true
        warn("💾 เก็บค่าในหน่วยความจำ: " .. calcState.memory)
    end
    
    local function MemoryRecall()
        if calcState.hasMemory then
            calcState.currentNumber = tostring(calcState.memory)
            calcState.isNewNumber = true
            UpdateDisplay()
            warn("📤 ดึงค่าจากหน่วยความจำ: " .. calcState.memory)
        end
    end
    
    local function MemoryClear()
        calcState.memory = 0
        calcState.hasMemory = false
        warn("🗑️ ล้างหน่วยความจำแล้ว")
    end
    
    -- สร้างปุ่มเครื่องคิดเลข
    -- แถวที่ 1 (ฟังก์ชันพิเศษ)
    local btnMC = CreateCalcButton("MC", 0.01, 0.18, Color3.fromRGB(80, 60, 80))
    local btnMR = CreateCalcButton("MR", 0.25, 0.18, Color3.fromRGB(80, 60, 80))
    local btnMS = CreateCalcButton("MS", 0.49, 0.18, Color3.fromRGB(80, 60, 80))
    local btnMPlus = CreateCalcButton("M+", 0.73, 0.18, Color3.fromRGB(80, 60, 80))
    
    btnMC.MouseButton1Click:Connect(MemoryClear)
    btnMR.MouseButton1Click:Connect(MemoryRecall)
    btnMS.MouseButton1Click:Connect(MemoryStore)
    btnMPlus.MouseButton1Click:Connect(function()
        calcState.memory = calcState.memory + (tonumber(calcState.currentNumber) or 0)
        calcState.hasMemory = true
        warn("📥 เพิ่มค่าในหน่วยความจำ: " .. calcState.memory)
    end)
    
    -- แถวที่ 2
    local btnClear = CreateCalcButton("C", 0.01, 0.33, Color3.fromRGB(200, 50, 50))
    local btnBack = CreateCalcButton("⌫", 0.25, 0.33, Color3.fromRGB(200, 120, 50))
    local btnPercent = CreateCalcButton("%", 0.49, 0.33, Color3.fromRGB(60, 80, 100))
    local btnDivide = CreateCalcButton("÷", 0.73, 0.33, Color3.fromRGB(255, 150, 0))
    
    btnClear.MouseButton1Click:Connect(ClearAll)
    btnBack.MouseButton1Click:Connect(Backspace)
    btnPercent.MouseButton1Click:Connect(function()
        InputOperation("%")
    end)
    btnDivide.MouseButton1Click:Connect(function()
        InputOperation("÷")
    end)
    
    -- แถวที่ 3
    local btn7 = CreateCalcButton("7", 0.01, 0.48, Color3.fromRGB(50, 50, 60))
    local btn8 = CreateCalcButton("8", 0.25, 0.48, Color3.fromRGB(50, 50, 60))
    local btn9 = CreateCalcButton("9", 0.49, 0.48, Color3.fromRGB(50, 50, 60))
    local btnMultiply = CreateCalcButton("×", 0.73, 0.48, Color3.fromRGB(255, 150, 0))
    
    btn7.MouseButton1Click:Connect(function() InputNumber(7) end)
    btn8.MouseButton1Click:Connect(function() InputNumber(8) end)
    btn9.MouseButton1Click:Connect(function() InputNumber(9) end)
    btnMultiply.MouseButton1Click:Connect(function()
        InputOperation("×")
    end)
    
    -- แถวที่ 4
    local btn4 = CreateCalcButton("4", 0.01, 0.63, Color3.fromRGB(50, 50, 60))
    local btn5 = CreateCalcButton("5", 0.25, 0.63, Color3.fromRGB(50, 50, 60))
    local btn6 = CreateCalcButton("6", 0.49, 0.63, Color3.fromRGB(50, 50, 60))
    local btnMinus = CreateCalcButton("-", 0.73, 0.63, Color3.fromRGB(255, 150, 0))
    
    btn4.MouseButton1Click:Connect(function() InputNumber(4) end)
    btn5.MouseButton1Click:Connect(function() InputNumber(5) end)
    btn6.MouseButton1Click:Connect(function() InputNumber(6) end)
    btnMinus.MouseButton1Click:Connect(function()
        InputOperation("-")
    end)
    
    -- แถวที่ 5
    local btn1 = CreateCalcButton("1", 0.01, 0.78, Color3.fromRGB(50, 50, 60))
    local btn2 = CreateCalcButton("2", 0.25, 0.78, Color3.fromRGB(50, 50, 60))
    local btn3 = CreateCalcButton("3", 0.49, 0.78, Color3.fromRGB(50, 50, 60))
    local btnPlus = CreateCalcButton("+", 0.73, 0.78, Color3.fromRGB(255, 150, 0))
    
    btn1.MouseButton1Click:Connect(function() InputNumber(1) end)
    btn2.MouseButton1Click:Connect(function() InputNumber(2) end)
    btn3.MouseButton1Click:Connect(function() InputNumber(3) end)
    btnPlus.MouseButton1Click:Connect(function()
        InputOperation("+")
    end)
    
    -- แถวที่ 6
    local btnSign = CreateCalcButton("±", 0.01, 0.93, Color3.fromRGB(60, 60, 80))
    local btn0 = CreateCalcButton("0", 0.25, 0.93, Color3.fromRGB(50, 50, 60))
    local btnDot = CreateCalcButton(".", 0.49, 0.93, Color3.fromRGB(50, 50, 60))
    local btnEqual = CreateCalcButton("=", 0.73, 0.93, Color3.fromRGB(50, 200, 50))
    
    btnSign.MouseButton1Click:Connect(ToggleSign)
    btn0.MouseButton1Click:Connect(function() InputNumber(0) end)
    btnDot.MouseButton1Click:Connect(function()
        if not string.find(calcState.currentNumber, "%.") then
            calcState.currentNumber = calcState.currentNumber .. "."
        end
        UpdateDisplay()
    end)
    btnEqual.MouseButton1Click:Connect(Calculate)
    
    -- ฟังก์ชันเพิ่มเติม (Square Root, Power)
    local function AddExtraFunction(text, xPos, yPos, operation)
        local btn = CreateCalcButton(text, xPos, yPos, Color3.fromRGB(60, 80, 100))
        btn.MouseButton1Click:Connect(function()
            if operation == "√" then
                local num = tonumber(calcState.currentNumber) or 0
                if num >= 0 then
                    calcState.currentNumber = tostring(math.sqrt(num))
                    calcState.isNewNumber = true
                    UpdateDisplay()
                else
                    display.Text = "Error"
                end
            elseif operation == "^" then
                InputOperation("^")
            end
        end)
        return btn
    end
    
    -- เพิ่มปุ่ม √ และ x²
    local btnSqrt = AddExtraFunction("√", 0.01, 0.035, "√")
    local btnPower = AddExtraFunction("x²", 0.25, 0.035, "^")
    local btnPi = CreateCalcButton("π", 0.49, 0.035, Color3.fromRGB(60, 80, 100))
    btnPi.MouseButton1Click:Connect(function()
        calcState.currentNumber = tostring(math.pi)
        calcState.isNewNumber = true
        UpdateDisplay()
    end)
    
    return calcFrame
end

